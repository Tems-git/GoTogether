{
  "expo": {
    "name": "GoTogether",
    "slug": "gotogether",
    "version": "1.0.0",
    "scheme": "gotogether",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.temsit.gotogether",
      "infoPlist": {
        "NSCameraUsageDescription": "GoTogether използва камерата за снимане на документи.",
        "NSPhotoLibraryUsageDescription": "GoTogether използва галерията за качване на документи и снимки.",
        "NSPhotoLibraryAddUsageDescription": "GoTogether запазва снимки в галерията.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.temsit.gotogether",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A6B57"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "GoTogether използва галерията за качване на документи и снимки.",
          "cameraPermission": "GoTogether използва камерата за снимане на документи."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#0A6B57"
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GoTogether ползва местоположението само когато натиснеш „Около мен“, за да покаже какво има около теб на картата."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "GoTogether записва снимка в галерията ти само когато сам поискаш.",
          "photosPermission": "GoTogether записва снимка в галерията ти само когато сам поискаш.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*"]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A6B57",
          "defaultChannel": "messages"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ce8969c9-88b7-42cb-838f-d3849a88cbcc"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ce8969c9-88b7-42cb-838f-d3849a88cbcc"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
